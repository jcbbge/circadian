<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>_Metadata</key>
    <dict>
        <key>Purpose</key>
        <string>Circadian REM CATCH-UP — runs rem-popmem.ts --if-due at every login/restart (RunAtLoad). --if-due runs the population-memory REM pass only if the most recent 09:00/21:00 slot was missed, and never double-runs a slot. Pairs with com.circadian.rem (the unconditional 09:00 &amp; 21:00 scheduled job) so a slot missed while the laptop was closed runs at the next opportunity. Successor payload to rem.ts (popmem WS-F switchover); same schedule, same job label.</string>
    </dict>
    <key>Label</key>
    <string>com.circadian.rem-catchup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jrg/.bun/bin/bun</string>
        <string>/Users/jrg/circadian/src/rem-popmem.ts</string>
        <string>--if-due</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jrg/circadian/logs/rem.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jrg/circadian/logs/rem.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/jrg/.bun/bin</string>
        <key>CIRCADIAN_HOME</key>
        <string>/Users/jrg/circadian</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/jrg/circadian</string>
</dict>
</plist>
