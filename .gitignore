# --- privacy boundary -------------------------------------------------------
# mind/ is YOUR living memory: SELF.md, JRG.md (private, never leaves the
# machine), NOW.md, episodes/, scoreboard.jsonl. It is its own git repo with
# its own history and NO remote (MIND-SPEC.md). It must never enter this
# public repo. The install script scaffolds a fresh mind/ from templates/ on
# each user's machine.
mind/

# runtime logs (launchd stdout/stderr + event ledgers)
logs/*.log
logs/*.jsonl
logs/.population-vitals.json
logs/.status-snap-*.json
logs/fleet/
# backups/archives of mind state may contain private memory — never publish
logs/*.bak
logs/*scoreboard*
logs/*.mind-backup*

# pi's per-project runtime state (session state, not source)
.pi/

# os / editor cruft
.DS_Store
node_modules/
logs/sleep-claims/
logs/llm-cap/
logs/invocations.jsonl
logs/.statusline
logs/.rem-popmem.ifdue.lock
logs/pending-sleep.lock
